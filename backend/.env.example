DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: sqlite (default, zero setup) or mysql
DB_ENGINE=sqlite
# DB_ENGINE=mysql
DB_NAME=foodstuff
DB_USER=foodstuff
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Contact form email (console backend just prints emails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Foodstuff <no-reply@foodstuff.local>
CONTACT_RECIPIENT=raghulvel63@gmail.com
